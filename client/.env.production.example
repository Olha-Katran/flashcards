# Production — used by `vite build`. On Vercel, set the same keys for Environment: Production
# (Project: e.g. client-gamma-ruby-68), then Redeploy so the bundle picks them up.
#
# Backend API origin — no trailing slash (must match your deployed server).
VITE_API_URL=https://server-blond-five-62.vercel.app
#
# Web client ID — same value as server GOOGLE_CLIENT_ID. In Google Cloud Console → Credentials →
# OAuth 2.0 Client → Authorized JavaScript origins, add:
#   https://client-gamma-ruby-68.vercel.app
VITE_GOOGLE_CLIENT_ID=
