# API origin only (no /api suffix). The client calls `${VITE_API_URL}/api/...`.
VITE_API_URL=http://localhost:3001

# Google Sign-In (Web client ID — same project as server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Remote backend (Vercel) — use in Production env or .env.production:
# VITE_API_URL=https://server-blond-five-62.vercel.app
