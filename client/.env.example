# API origin (no /api suffix). The client calls `${VITE_API_URL}/api/...`.
# Leave empty for local dev: Vite proxies `/api` → http://127.0.0.1:3001 (start the server first).
# VITE_API_URL=
# Or call the API directly (needs CORS):
VITE_API_URL=http://localhost:3001

# Google Sign-In (Web client ID — same project as server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Remote backend (Vercel) — use in Production env or .env.production:
# VITE_API_URL=https://server-blond-five-62.vercel.app
