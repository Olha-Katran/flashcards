# --- Local development ---
PORT=3001

# Postgres (Prisma). Use DATABASE_URL or POSTGRES_PRISMA_URL (Vercel Postgres often provides both).
DATABASE_URL=
# POSTGRES_PRISMA_URL=

JWT_SECRET=

# Web application OAuth 2.0 Client ID (same string as client VITE_GOOGLE_CLIENT_ID).
# In Google Cloud Console add Authorized JavaScript origins for your frontend URL(s).
GOOGLE_CLIENT_ID=

GEMINI_API_KEY=

# --- CORS (backend) — required for browser access from your Vite app ---
# Primary: comma-separated allowed origins (no path, no trailing slash). Example:
#   FRONTEND_URL=https://client-abc123.vercel.app,https://mydomain.com
FRONTEND_URL=http://localhost:5173

# Legacy alias; merged with FRONTEND_URL if you still use it:
# CLIENT_ORIGIN=

# Allow any https://*.vercel.app (production + preview URLs). Default behavior when unset.
# Set to "false" to allow only FRONTEND_URL / CLIENT_ORIGIN (stricter).
# CORS_ALLOW_VERCEL_PREVIEWS=true

# In production (NODE_ENV=production), localhost is blocked unless you set:
# CORS_ALLOW_LOCALHOST=true
# (Useful when the local Vite app calls the deployed API.)
