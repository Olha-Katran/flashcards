# --- Local development ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Postgres (Prisma). Use DATABASE_URL or POSTGRES_PRISMA_URL (Vercel Postgres often provides both).
DATABASE_URL=
# POSTGRES_PRISMA_URL=

JWT_SECRET=

# Web application OAuth 2.0 Client ID (same string as client VITE_GOOGLE_CLIENT_ID).
# No spaces/newlines. Sign-In with Google posts a JWT to POST /api/auth/google — there is no
# backend “callback URL”; in Google Cloud Console add Authorized JavaScript origins:
#   https://your-frontend.vercel.app
# (and http://localhost:5173 for local). Do not use an Android/iOS client ID here.
GOOGLE_CLIENT_ID=

GEMINI_API_KEY=

# --- Vercel / production ---
# Exact production frontend origin (CORS). Example:
# CLIENT_ORIGIN=https://client-gamma-ruby-68.vercel.app
